{
  "name": "multi-agent-code-studio",
  "version": "1.5.20",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "author": "Vladimir <nasha_masha45@mail.ru>",
  "description": "Multi-agent AI code editor with orchestrator, auto-fix loop and desktop packaging.",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "electron:open": "node scripts/electron-open.cjs",
    "build:standalone": "next build && node scripts/prepare-standalone.cjs",
    "dist": "npm run build:standalone && electron-builder --win",
    "package": "npm run build:standalone && electron-builder --win --dir",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "electron-updater": "^6.8.9",
    "localtunnel": "^2.0.2",
    "monaco-editor": "^0.56.0",
    "next": "16.2.6",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/localtunnel": "^2.0.4",
    "@types/node": "22.19.15",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.multiagent.codestudio",
    "forceCodeSigning": false,
    "productName": "Multi-Agent Code Studio",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone"
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "standalone/node_modules"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "Vladimir45rus",
      "repo": "Multi-agents"
    },
    "mac": {
      "x64ArchFiles": "**/*.{node,dylib}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
